{
  "name": "sample-node",
  "version": "v0.16.0",
  "description": "Node.js sample app",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json",
    "build": "npm ci",
    "start": "node server.js",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "sonar": "sonar-scanner-npm"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "moment-timezone": "^0.6.6",
    "prom-client": "^15.1.2",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jest": "^30.5.2",
    "jest-sonar-reporter": "^2.0.0",
    "sonarqube-scanner": "^5.0.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
