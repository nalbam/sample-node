<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/style.css">
    <title>sample-node · drop <%= rate %>%</title>
</head>

<body>

    <main class="panel">
        <header class="panel-bar">
            <span class="lamp"></span>
            <span class="unit">sample-node</span>
            <span class="bar-spec"><span class="tag">success</span> <%= rate %>%</span>
            <nav class="modes">
                <a class="mode" href="/">status</a>
                <a class="mode is-on" href="/drop">drop</a>
            </nav>
        </header>

        <section class="plate">
            <p class="tag">version split</p>
            <div id="drop-rate"></div>
        </section>
    </main>

    <script>
        let rate = "<%= rate %>";
    </script>
    <script src="/dropper.js"></script>

</body>

</html>
