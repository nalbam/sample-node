<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/style.css">
  <title>sample-node · <%= host %></title>
</head>

<body>

  <main class="panel">
    <header class="panel-bar">
      <span class="lamp"></span>
      <span class="unit">sample-node</span>
      <nav class="modes">
        <a class="mode is-on" href="/">status</a>
        <a class="mode" href="/drop">drop</a>
      </nav>
    </header>

    <section class="plate">
      <p class="tag">host</p>
      <h1 class="host" style="--len: <%= host.length %>">
        <%= host %>
      </h1>

      <dl class="spec">
        <dt class="tag">cluster</dt>
        <dd>
          <%= cluster %>
        </dd>
        <dt class="tag">profile</dt>
        <dd>
          <%= profile %>
        </dd>
        <dt class="tag">version</dt>
        <dd>
          <%= version %>
        </dd>
        <dt class="tag">time</dt>
        <dd>
          <time datetime="<%= date %>">
            <%= date %>
          </time>
        </dd>
      </dl>

      <% if (message) { %>
      <p class="note">
        <%= message %>
      </p>
      <% } %>
    </section>

    <section class="controls">
      <div class="tally">
        <p class="tag">tally</p>
        <div class="tally-keys">
          <button class="key btn-thumbs-up" aria-label="thumbs up">👍 <span id="thumbs-up-count">0</span></button>
          <button class="key btn-thumbs-down" aria-label="thumbs down">👎 <span id="thumbs-down-count">0</span></button>
        </div>
      </div>

      <div class="estop">
        <p class="tag">kill switch</p>
        <button class="estop-btn btn-kill" aria-label="kill this instance with an OOM">
          <span class="estop-face">kill</span>
        </button>
      </div>
    </section>

    <p class="status" id="kill-status"></p>

    <section class="rotation" id="rotation" hidden>
      <p class="tag">versions in rotation</p>
      <div class="progress"></div>
      <p class="tag rotation-legend"></p>
    </section>
  </main>

  <dialog class="sheet" id="kill-dialog" aria-labelledby="kill-dialog-title">
    <p class="tag" id="kill-dialog-title">kill switch</p>
    <p class="sheet-body">
      This allocates memory until the kernel kills the process. The pod goes down and its
      controller decides whether to bring it back.
    </p>
    <div class="sheet-actions">
      <button class="key" type="button" id="kill-cancel">cancel</button>
      <button class="key key-danger" type="button" id="kill-confirm">kill</button>
    </div>
  </dialog>

  <script src="/time.js"></script>
  <script src="/counter.js"></script>
  <script src="/kill.js"></script>
  <script src="/rotation.js"></script>

</body>

</html>
